#!/bin/sh
set -e
# "Remove" keeps your settings in /var/lib/casatorch (and the key store's wrapping key in /etc/casatorch); "purge"
# deletes them too.
if [ "$1" = purge ]; then rm -rf /var/lib/casatorch /etc/casatorch; getent passwd casatorch >/dev/null && deluser --system casatorch >/dev/null 2>&1 || true; fi
[ -d /run/systemd/system ] && systemctl daemon-reload >/dev/null 2>&1 || true
exit 0
