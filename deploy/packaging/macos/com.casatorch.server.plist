<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.casatorch.server</string>
  <key>ProgramArguments</key><array><string>/Library/CasaTorch/casatorch-run.sh</string></array>
  <!-- Started as root only so CasaTorch can read its wrapping key from the System keychain; it then switches to its
       own user (_casatorch, or nobody on a Mac where that account couldn't be made) before doing anything else, and
       stops rather than run as root (casatorch-run.sh, casatorch-launch.mjs, 00-keystore.js). -->
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>/Library/Application Support/CasaTorch/casatorch.log</string>
  <key>StandardErrorPath</key><string>/Library/Application Support/CasaTorch/casatorch.log</string>
</dict>
</plist>
