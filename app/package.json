{
  "name": "casatorch",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "CasaTorch: a self-hosted wall-panel dashboard for your house and your homelab",
  "license": "AGPL-3.0-only",
  "main": "server.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && node server.js",
    "demo": "node build.mjs && CASATORCH_DEMO=1 node server.js",
    "scrub": "node ../tools/scrub-check.mjs .",
    "test": "node ../tools/test-all.mjs",
    "test:all": "node ../tools/test-all.mjs",
    "test:unit": "node build.mjs && node test/unit.mjs",
    "test:security": "node build.mjs && node ../tools/test-security.mjs",
    "test:chaos": "node build.mjs && node ../tools/test-chaos.mjs",
    "test:e2e": "node ../tools/test-all.mjs --only=build,e2e-wizard,e2e-noha",
    "test:fast": "node ../tools/test-all.mjs --no-e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "acme-client": "5.4.0",
    "express": "^4.21.2",
    "multicast-dns": "7.2.5",
    "qrcode": "1.5.4",
    "ring-client-api": "^14.3.0",
    "three": "0.185.1",
    "web-push": "3.6.7"
  },
  "overrides": {
    "werift": "0.25.0"
  }
}
